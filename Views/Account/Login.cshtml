@model ImportDataToERP.Models.LoginViewModel
@{
    ViewData["Title"] = "登入";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-lg p-10 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="text-5xl mb-3">📦</div>
            <h2 class="text-2xl font-bold text-gray-800">ImportDataToERP</h2>
            <p class="text-gray-500 text-sm mt-2">請登入以使用系統功能</p>
        </div>

        <form asp-action="Login" method="post" asp-route-returnUrl="@returnUrl" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg border border-red-200"></div>

            <div>
                <label asp-for="Account" class="block text-sm font-medium text-gray-700 mb-1.5">帳號</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">👤</span>
                    <input asp-for="Account" class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" placeholder="請輸入帳號" autofocus />
                </div>
                <span asp-validation-for="Account" class="text-red-500 text-xs mt-1 inline-block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1.5">密碼</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">🔒</span>
                    <input asp-for="Password" class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" placeholder="請輸入密碼" />
                </div>
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 inline-block"></span>
            </div>

            <div class="flex items-center">
                <input asp-for="RememberMe" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 h-4 w-4" />
                <label asp-for="RememberMe" class="ml-2 text-sm text-gray-600">記住我</label>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg text-sm font-medium transition cursor-pointer">
                登入
            </button>
        </form>
    </div>
</div>
