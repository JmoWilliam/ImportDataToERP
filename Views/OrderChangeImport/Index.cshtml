@model IEnumerable<ImportDataToERP.Models.OrderChangeHeader>
@{
    ViewData["Title"] = "匯入訂單變更To ERP";
}

<div class="card p-6">
    <!-- Top Bar -->
    <div class="flex justify-between items-center mb-6 flex-wrap gap-3">
        <div>
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                🔄 匯入訂單變更To ERP
                @if (Model.Any())
                {
                    <span class="badge badge-info text-xs">@Model.Count() 筆</span>
                }
            </h2>
            <p class="text-sm text-gray-400 mt-0.5">管理已匯入的訂單變更資料，可編輯明細後拋轉至ERP系統</p>
        </div>
        <div class="flex gap-2">
            <a asp-action="DownloadTemplate" class="btn inline-flex items-center gap-1.5 bg-gray-600 hover:bg-gray-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                下載匯入格式
            </a>
            <a asp-action="Create" class="btn inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                新增變更單
            </a>
            <form id="uploadForm" method="post" enctype="multipart/form-data" asp-action="Upload" class="inline-flex items-center gap-2 bg-blue-50/80 rounded-lg px-4 py-2 border border-blue-100">
                <label class="btn cursor-pointer inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    上傳Excel
                    <input type="file" name="file" accept=".xlsx,.xls" class="hidden" onchange="this.form.submit()" />
                </label>
                <span id="fileName" class="text-xs text-gray-400 max-w-[150px] truncate"></span>
            </form>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl mb-4 text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-4 text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
            @TempData["Error"]
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="flex items-center gap-2 bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-xl mb-4 text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
            @TempData["Warning"]
        </div>
    }

    @if (!Model.Any())
    {
        <!-- Empty State: 完全獨立於 table 外 -->
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
            <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <span class="text-sm text-gray-500 mb-2">尚無匯入資料</span>
            <span class="text-sm">
                <a asp-action="DownloadTemplate" class="text-blue-500 hover:text-blue-600 underline font-medium">下載匯入格式</a>
                <span class="text-gray-300 mx-1">|</span>
                <a asp-action="Create" class="text-blue-500 hover:text-blue-600 underline font-medium">手動新增</a>
            </span>
        </div>
    }
    else
    {
        <!-- Data Table: 只在有資料時才渲染 -->
        <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="min-w-full">
                <thead>
                    <tr class="bg-gray-50/80">
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">匯入單號</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">ERP單號</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">原訂單號</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">客戶名稱</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">單據日期</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">明細</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">匯入狀態</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100">ERP拋轉</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider border-b-2 border-gray-100 w-36">操作</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/30 transition-colors">
                            <td class="px-4 py-3">
                                <span class="font-mono text-sm text-blue-700 font-medium">@item.ImportBatchNo</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(item.ErpOrderNo))
                                {
                                    <span class="font-mono text-sm text-green-600 font-medium">@item.ErpOrderNo</span>
                                }
                                else
                                {
                                    <span class="text-gray-300 text-sm">—</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <span class="font-mono text-sm font-medium text-gray-700">
                                    @(string.IsNullOrEmpty(item.OriginalOrderNo)
                                        ? "—"
                                        : item.OriginalOrderNo)
                                </span>
                            </td>
                            <td class="px-4 py-3 text-sm font-medium text-gray-800">@(item.CustomerName ?? item.CustomerCode)</td>
                            <td class="px-4 py-3 text-sm text-gray-600 text-center whitespace-nowrap">@item.DocDate?.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-sm text-center">
                                <span class="text-blue-600 font-semibold">@item.DetailCount 筆</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (item.ImportStatus == "已匯入")
                                { <span class="badge badge-success">✓ 已匯入</span> }
                                else
                                { <span class="badge badge-warning">⏳ 待匯入</span> }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @switch (item.TransferStatus)
                                {
                                    case 1: <span class="badge badge-muted">未拋轉</span> break;
                                    case 2: <span class="badge badge-success">✓ 已拋轉</span> break;
                                    case 3: <span class="badge badge-error cursor-help" title="@item.TransferMessage">✕ 失敗</span> break;
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100">編輯</a>
                                    @if (item.TransferStatus != 2)
                                    {
                                        <form asp-action="TransferToErp" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('確認拋轉此變更單到ERP？')">
                                            <button type="submit" class="btn px-2.5 py-1 rounded-lg text-xs font-medium bg-purple-50 text-purple-700 hover:bg-purple-100">拋轉</button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('確認刪除此變更紀錄？')">
                                        <button type="submit" class="btn px-2.5 py-1 rounded-lg text-xs font-medium bg-red-50 text-red-600 hover:bg-red-100">刪除</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
document.getElementById('uploadForm').addEventListener('change', function(e) {
    var file = e.target.files[0];
    document.getElementById('fileName').textContent = file ? file.name : '';
});
</script>
