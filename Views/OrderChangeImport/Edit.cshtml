@model ImportDataToERP.Models.OrderChangeHeader
@{
    ViewData["Title"] = Model.Id == 0 ? "新增訂單變更" : $"編輯訂單變更 - {Model.ImportBatchNo}";
    var details = ViewBag.Details as IEnumerable<ImportDataToERP.Models.OrderChangeDetail> ?? new List<OrderChangeDetail>();
    var detailList = details.ToList();
}

<div class="card p-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                @(Model.Id == 0 ? "🔄 新增訂單變更" : "🔄 編輯訂單變更")
            </h2>
            @if (Model.Id > 0)
            {
                <div class="flex items-center gap-3 mt-1.5 text-sm">
                    <span class="text-gray-500">匯入單號：<span class="font-mono text-blue-700 font-medium">@Model.ImportBatchNo</span></span>
                    <span class="text-gray-300">|</span>
                    <span>ERP拋轉：
                        @switch (Model.TransferStatus)
                        {
                            case 1: <span class="badge badge-muted">未拋轉</span> break;
                            case 2: <span class="badge badge-success">已拋轉 <span class="font-mono">@Model.ErpOrderNo</span></span> break;
                            case 3: <span class="badge badge-error cursor-help" title="@Model.TransferMessage">拋轉失敗</span> break;
                        }
                    </span>
                </div>
            }
        </div>
        <a asp-action="Index" class="text-sm text-gray-400 hover:text-gray-600 flex items-center gap-1 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg> 回列表
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl mb-4 text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-4 text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
            @TempData["Error"]
        </div>
    }

    <!-- ========== 單頭變更區 ========== -->
    <div class="section-card bg-gradient-to-br from-blue-50/40 to-white">
        <div class="flex justify-between items-center mb-4">
            <div class="section-title" style="margin-bottom:0">
                <span class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm">H</span>
                單頭資料
            </div>
            @if (Model.Id > 0 && Model.TransferStatus != 2)
            {
                <form asp-action="TransferToErp" asp-controller="OrderChangeImport" asp-route-id="@Model.Id" method="post" class="inline" onsubmit="return confirm('確認拋轉此變更單到ERP？')">
                    <button type="submit" class="btn inline-flex items-center gap-1.5 bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        拋轉ERP
                    </button>
                </form>
            }
        </div>
        <form method="post" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-controller="OrderChangeImport" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id" />

            <!-- Row 1: SoErpPrefix (readonly), SoErpNo (readonly), DocDate + ClosureStatus -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">原訂單單別</label>
                    <input asp-for="SoErpPrefix" class="input-modern w-full bg-gray-50" placeholder="例: 220" readonly="@(Model.Id > 0)" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">原訂單單號</label>
                    <input asp-for="SoErpNo" class="input-modern w-full bg-gray-50" placeholder="原訂單號" readonly="@(Model.Id > 0)" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5 flex items-center justify-between">
                        <span>單據日期</span>
                        <label class="inline-flex items-center gap-1 cursor-pointer select-none">
                            <input type="checkbox" id="cbxClosureStatus" name="ClosureStatusCheck" value="Y" class="w-3.5 h-3.5 text-blue-600 rounded" @(Model.ClosureStatus == "Y" ? "checked" : "") onchange="document.getElementById('ClosureStatus').value = this.checked ? 'Y' : 'N'" />
                            <span class="text-xs text-gray-500">整張結案</span>
                        </label>
                    </label>
                    <input asp-for="ClosureStatus" type="hidden" />
                    <input asp-for="DocDate" type="date" value="@(Model.DocDate?.ToString("yyyy-MM-dd"))" class="input-modern w-full" />
                </div>
            </div>

            <!-- Row 2: CustomerPurchaseOrder, CustomerCode+CustomerName -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">客戶採購單</label>
                    <input asp-for="CustomerPurchaseOrder" class="input-modern w-full" placeholder="客戶採購單號" maxlength="20" />
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1.5">客戶代號 <span class="text-red-400">*</span></label>
                        <input asp-for="CustomerCode" required class="input-modern w-full" placeholder="例: EC_KS" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1.5">客戶名稱</label>
                        <input asp-for="CustomerName" class="input-modern w-full" placeholder="客戶名稱" />
                    </div>
                </div>
            </div>

            <!-- Row 3: DepartmentId, SalesRep -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">部門代號</label>
                    <input asp-for="DepartmentId" class="input-modern w-full" placeholder="例: 6100" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">業務人員</label>
                    <input asp-for="SalesRep" class="input-modern w-full" placeholder="例: E13015" />
                </div>
            </div>

            <!-- Row 4: Remarks -->
            <div class="mb-4">
                <label class="block text-xs font-semibold text-gray-600 mb-1.5">備註</label>
                <textarea asp-for="Remarks" class="input-modern w-full" rows="2" placeholder="請輸入備註" maxlength="255"></textarea>
            </div>

            <!-- Row 5: ChangeReason -->
            <div class="mb-4">
                <label class="block text-xs font-semibold text-gray-600 mb-1.5">變更原因</label>
                <textarea asp-for="ChangeReason" class="input-modern w-full" rows="2" placeholder="請輸入變更原因" maxlength="255"></textarea>
            </div>

            <div class="flex gap-3 mt-5">
                <button type="submit" class="btn inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                    儲存單頭
                </button>
            </div>
        </form>
    </div>

    <!-- ========== 客戶基本資料 (Collapsible) ========== -->
    @if (Model.Id > 0)
    {
        <details class="mb-4" id="customerBasicSection">
            <summary class="cursor-pointer text-sm font-semibold text-gray-700 hover:text-blue-600 py-2">
                📋 客戶基本資料
            </summary>
            <div class="section-card mt-2">
                <form id="customerBasicForm" method="post" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-controller="OrderChangeImport" asp-route-id="@Model.Id">
                    <input type="hidden" asp-for="Id" />

                    <!-- Row 1: CustomerAddressFirst, CustomerAddressSecond -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">客戶聯絡地址(一) <span class="text-red-400">*</span></label>
                            <input asp-for="CustomerAddressFirst" class="input-modern w-full" placeholder="請輸入客戶聯絡地址(一)" maxlength="200" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">客戶聯絡地址(二)</label>
                            <input asp-for="CustomerAddressSecond" class="input-modern w-full" placeholder="請輸入客戶聯絡地址(二)" maxlength="200" />
                        </div>
                    </div>

                    <!-- Row 2: Currency + ExchangeRate -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">交易幣別 <span class="text-red-400">*</span></label>
                            <select asp-for="Currency" class="input-modern w-full">
                                <option value="NTD">NTD 台幣</option>
                                <option value="USD">USD 美金</option>
                                <option value="HKD">HKD 港幣</option>
                                <option value="RMB">RMB 人民幣</option>
                                <option value="JPY">JPY 日圓</option>
                                <option value="EUR">EUR 歐元</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">匯率 <span class="text-red-400">*</span></label>
                            <input asp-for="ExchangeRate" type="number" step="0.0001" class="input-modern w-full" placeholder="請輸入匯率" />
                        </div>
                    </div>

                    <!-- Row 3: TradeTerm, TaxNo+Taxation+BusinessTaxRate -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">交易條件</label>
                            <input asp-for="TradeTerm" class="input-modern w-full" placeholder="1.FOB 2.CIF ..." />
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1.5">稅別碼</label>
                                <input asp-for="TaxNo" class="input-modern w-full" placeholder="稅別碼" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1.5">課稅別</label>
                                <select asp-for="Taxation" class="input-modern w-full">
                                    <option value="">—</option>
                                    <option value="1">1.內含</option>
                                    <option value="2">2.外加</option>
                                    <option value="3">3.零稅率</option>
                                    <option value="4">4.免稅</option>
                                    <option value="9">9.不計稅</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1.5">營業稅率</label>
                                <input asp-for="BusinessTaxRate" type="number" step="0.01" class="input-modern w-full bg-gray-50" placeholder="稅率" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: PaymentTerm, PriceTerm -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">付款條件</label>
                            <input asp-for="PaymentTerm" class="input-modern w-full" placeholder="付款條件" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">價格條件</label>
                            <input asp-for="PriceTerm" class="input-modern w-full" placeholder="請輸入價格條件" maxlength="40" />
                        </div>
                    </div>

                    <!-- Row 5: DepositPartial (Y/N radio), DepositRate -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">訂金分批</label>
                            <div class="flex items-center gap-4 pt-1">
                                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                    <input type="radio" name="DepositPartial" value="Y" class="w-3.5 h-3.5" @(Model.DepositPartial == "Y" ? "checked" : "") id="depositPartialY" />
                                    <span class="text-sm">是</span>
                                </label>
                                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                    <input type="radio" name="DepositPartial" value="N" class="w-3.5 h-3.5" @(Model.DepositPartial != "Y" ? "checked" : "") id="depositPartialN" />
                                    <span class="text-sm">否</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">訂金比率</label>
                            <input asp-for="DepositRate" type="number" step="0.01" class="input-modern w-full" placeholder="請輸入訂金比率" />
                        </div>
                    </div>

                    <!-- Row 6: DetailMultiTax (Y/N radio), ShipMethod -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">單身多稅率</label>
                            <div class="flex items-center gap-4 pt-1">
                                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                    <input type="radio" name="DetailMultiTax" value="Y" class="w-3.5 h-3.5" @(Model.DetailMultiTax == "Y" ? "checked" : "") id="detailMultiTaxY" />
                                    <span class="text-sm">是</span>
                                </label>
                                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                    <input type="radio" name="DetailMultiTax" value="N" class="w-3.5 h-3.5" @(Model.DetailMultiTax != "Y" ? "checked" : "") id="detailMultiTaxN" />
                                    <span class="text-sm">否</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">運輸方式</label>
                            <input asp-for="ShipMethod" class="input-modern w-full" placeholder="1.空運 2.海運 ..." />
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" form="customerBasicForm" class="btn inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                            儲存客戶基本資料
                        </button>
                    </div>
                </form>
            </div>
        </details>
    }

    <!-- ========== 單身明細區 ========== -->
    @if (Model.Id > 0)
    {
        <div class="section-card">
            <div class="flex justify-between items-center mb-4">
                <div class="section-title" style="margin-bottom:0">
                    <span class="w-7 h-7 rounded-lg bg-green-600 text-white flex items-center justify-center text-sm">D</span>
                    變更明細
                    <span class="text-sm text-gray-400 font-normal" id="detailCount">(@detailList.Count 筆)</span>
                </div>
                <button onclick="addNewRow()" class="btn inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    新增明細
                </button>
            </div>

            @if (detailList.Count == 0)
            {
                <!-- 空明細狀態：不在 table 內 -->
                <div id="emptyDetailState" class="flex flex-col items-center justify-center py-12 text-gray-400 border-2 border-dashed border-gray-200 rounded-xl">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                        <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                    </div>
                    <span class="text-sm font-medium">尚無明細資料</span>
                    <span class="text-xs mt-1">點擊上方「新增明細」按鈕新增</span>
                </div>
            }
            else
            {
                <!-- 明細表格 -->
                <div class="overflow-x-auto max-h-[55vh] overflow-y-auto rounded-xl border border-gray-200" id="detailTableContainer">
                <table class="min-w-full" id="detailTable">
                    <thead class="bg-gray-50/80 sticky top-0 z-10 backdrop-blur">
                        <tr>
                            <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-500">品號</th>
                            <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-500">品名</th>
                            <th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">原數量</th>
                            <th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">新數量</th>
                            <th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">原單價</th>
                            <th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">新單價</th>
                            <th class="px-3 py-2.5 text-center text-xs font-semibold text-gray-500 w-28">原交期</th>
                            <th class="px-3 py-2.5 text-center text-xs font-semibold text-gray-500 w-28">新交期</th>
                            <th class="px-3 py-2.5 text-center text-xs font-semibold text-gray-500 w-28">操作</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50 bg-white">
                        @foreach (var d in detailList)
                        {
                            <tr id="row-@d.Id" class="detail-row hover:bg-blue-50/30 transition">
                                <!-- Read mode -->
                                <td class="px-3 py-2 view-mode font-mono text-xs text-gray-700">@d.ProductCode</td>
                                <td class="px-3 py-2 view-mode text-sm">@d.ProductName</td>
                                <td class="px-3 py-2 view-mode text-sm text-right">@d.OriginalQuantity?.ToString("N2")</td>
                                <td class="px-3 py-2 view-mode text-sm text-right font-medium @(d.NewQuantity != d.OriginalQuantity ? "text-orange-600" : "")">@d.NewQuantity?.ToString("N2")</td>
                                <td class="px-3 py-2 view-mode text-sm text-right">@d.OriginalUnitPrice?.ToString("N2")</td>
                                <td class="px-3 py-2 view-mode text-sm text-right font-medium @(d.NewUnitPrice != d.OriginalUnitPrice ? "text-orange-600" : "")">@d.NewUnitPrice?.ToString("N2")</td>
                                <td class="px-3 py-2 view-mode text-sm text-center">@d.OriginalDeliveryDate?.ToString("yyyy-MM-dd")</td>
                                <td class="px-3 py-2 view-mode text-sm text-center font-medium @(d.NewDeliveryDate != d.OriginalDeliveryDate ? "text-orange-600" : "")">@d.NewDeliveryDate?.ToString("yyyy-MM-dd")</td>

                                <!-- Edit mode -->
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-24 input-modern text-xs py-1 font-mono" value="@d.ProductCode" data-field="ProductCode" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-28 input-modern text-xs py-1" value="@d.ProductName" data-field="ProductName" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-20 input-modern text-xs py-1 text-right" value="@d.OriginalQuantity" data-field="OriginalQuantity" type="number" step="any" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-20 input-modern text-xs py-1 text-right" value="@d.NewQuantity" data-field="NewQuantity" type="number" step="any" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-20 input-modern text-xs py-1 text-right" value="@d.OriginalUnitPrice" data-field="OriginalUnitPrice" type="number" step="any" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-20 input-modern text-xs py-1 text-right" value="@d.NewUnitPrice" data-field="NewUnitPrice" type="number" step="any" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-28 input-modern text-xs py-1 text-center" value="@d.OriginalDeliveryDate?.ToString("yyyy-MM-dd")" data-field="OriginalDeliveryDate" type="date" /></td>
                                <td class="px-3 py-2 edit-mode hidden"><input class="w-28 input-modern text-xs py-1 text-center" value="@d.NewDeliveryDate?.ToString("yyyy-MM-dd")" data-field="NewDeliveryDate" type="date" /></td>

                                <!-- Actions -->
                                <td class="px-3 py-2 text-center whitespace-nowrap">
                                    <span class="view-mode flex items-center justify-center gap-1.5">
                                        <button onclick="editRow(@d.Id)" class="btn px-2 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-600 hover:bg-blue-100">編輯</button>
                                        <button onclick="deleteRow(@d.Id)" class="btn px-2 py-1 rounded-md text-xs font-medium bg-red-50 text-red-500 hover:bg-red-100">刪除</button>
                                    </span>
                                    <span class="edit-mode hidden flex items-center justify-center gap-1.5">
                                        <button onclick="saveRow(@d.Id)" class="btn px-2 py-1 rounded-md text-xs font-medium bg-green-50 text-green-600 hover:bg-green-100">儲存</button>
                                        <button onclick="cancelRow(@d.Id)" class="btn px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-500 hover:bg-gray-200">取消</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="section-card">
            <div class="flex flex-col items-center py-8 text-gray-400">
                <svg class="w-12 h-12 mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-sm">💡 請先儲存單頭後，即可新增明細</span>
            </div>
        </div>
    }
</div>

<script>
const headerId = @Model.Id;

// ── 表格範本 (空狀態 → 表格轉換用) ──
function ensureTable() {
    if (document.getElementById('detailTable')) return;
    const emptyEl = document.getElementById('emptyDetailState');
    if (emptyEl) emptyEl.style.display = 'none';
    const container = document.createElement('div');
    container.className = 'overflow-x-auto max-h-[55vh] overflow-y-auto rounded-xl border border-gray-200';
    container.id = 'detailTableContainer';
    container.innerHTML =
        '<table class="min-w-full" id="detailTable">' +
        '<thead class="bg-gray-50/80 sticky top-0 z-10 backdrop-blur">' +
        '<tr>' +
        '<th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-500">品號</th>' +
        '<th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-500">品名</th>' +
        '<th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">原數量</th>' +
        '<th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">新數量</th>' +
        '<th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">原單價</th>' +
        '<th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-500 w-22">新單價</th>' +
        '<th class="px-3 py-2.5 text-center text-xs font-semibold text-gray-500 w-28">原交期</th>' +
        '<th class="px-3 py-2.5 text-center text-xs font-semibold text-gray-500 w-28">新交期</th>' +
        '<th class="px-3 py-2.5 text-center text-xs font-semibold text-gray-500 w-28">操作</th>' +
        '</tr></thead>' +
        '<tbody class="divide-y divide-gray-50 bg-white"></tbody>' +
        '</table>';
    if (emptyEl) {
        emptyEl.parentNode.insertBefore(container, emptyEl.nextSibling);
    } else {
        // fallback: 直接插入頁面
        const section = document.querySelector('.section-card');
        if (section) section.appendChild(container);
    }
}

// ── 建構新明細列 (edit 模式) ──
function buildNewRowHtml(detail) {
    const id = detail.id;
    const v = (s) => (s || '');
    return '<tr id="row-' + id + '" class="detail-row hover:bg-blue-50/30 bg-blue-50/50">' +
        '<td class="px-3 py-2 view-mode hidden font-mono text-xs text-gray-700">' + v(detail.productCode) + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm">' + v(detail.productName) + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm text-right">' + (detail.originalQuantity != null ? Number(detail.originalQuantity).toLocaleString(undefined,{minimumFractionDigits:2}) : '') + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm text-right font-medium">' + (detail.newQuantity != null ? Number(detail.newQuantity).toLocaleString(undefined,{minimumFractionDigits:2}) : '') + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm text-right">' + (detail.originalUnitPrice != null ? Number(detail.originalUnitPrice).toLocaleString(undefined,{minimumFractionDigits:2}) : '') + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm text-right font-medium">' + (detail.newUnitPrice != null ? Number(detail.newUnitPrice).toLocaleString(undefined,{minimumFractionDigits:2}) : '') + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm text-center">' + v(detail.originalDeliveryDate) + '</td>' +
        '<td class="px-3 py-2 view-mode hidden text-sm text-center font-medium">' + v(detail.newDeliveryDate) + '</td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-24 input-modern text-xs py-1 font-mono" value="' + v(detail.productCode) + '" data-field="ProductCode" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-28 input-modern text-xs py-1" value="' + v(detail.productName) + '" data-field="ProductName" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-20 input-modern text-xs py-1 text-right" value="' + v(detail.originalQuantity) + '" data-field="OriginalQuantity" type="number" step="any" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-20 input-modern text-xs py-1 text-right" value="' + v(detail.newQuantity) + '" data-field="NewQuantity" type="number" step="any" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-20 input-modern text-xs py-1 text-right" value="' + v(detail.originalUnitPrice) + '" data-field="OriginalUnitPrice" type="number" step="any" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-20 input-modern text-xs py-1 text-right" value="' + v(detail.newUnitPrice) + '" data-field="NewUnitPrice" type="number" step="any" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-28 input-modern text-xs py-1 text-center" value="' + v(detail.originalDeliveryDate) + '" data-field="OriginalDeliveryDate" type="date" /></td>' +
        '<td class="px-3 py-2 edit-mode"><input class="w-28 input-modern text-xs py-1 text-center" value="' + v(detail.newDeliveryDate) + '" data-field="NewDeliveryDate" type="date" /></td>' +
        '<td class="px-3 py-2 text-center whitespace-nowrap">' +
        '<span class="view-mode hidden flex items-center justify-center gap-1.5">' +
        '<button onclick="editRow(' + id + ')" class="btn px-2 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-600 hover:bg-blue-100">編輯</button>' +
        '<button onclick="deleteRow(' + id + ')" class="btn px-2 py-1 rounded-md text-xs font-medium bg-red-50 text-red-500 hover:bg-red-100">刪除</button>' +
        '</span>' +
        '<span class="edit-mode flex items-center justify-center gap-1.5">' +
        '<button onclick="saveRow(' + id + ')" class="btn px-2 py-1 rounded-md text-xs font-medium bg-green-50 text-green-600 hover:bg-green-100">儲存</button>' +
        '<button onclick="cancelNewRow(' + id + ')" class="btn px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-500 hover:bg-gray-200">取消</button>' +
        '</span>' +
        '</td>' +
        '</tr>';
}

// ── 新增明細：直接建立並進入編輯模式 (一鍵到位) ──
async function addNewRow() {
    const data = {
        headerId: headerId,
        productCode: '', productName: '',
        originalQuantity: null, newQuantity: null,
        originalUnitPrice: null, newUnitPrice: null,
        originalDeliveryDate: null, newDeliveryDate: null
    };
    try {
        const resp = await fetch('/OrderChangeImport/CreateDetail', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (!resp.ok) throw new Error('Failed');
        const result = await resp.json();
        const detail = result.detail;

        ensureTable();
        const tbody = document.querySelector('#detailTable tbody');
        tbody.insertAdjacentHTML('beforeend', buildNewRowHtml(detail));

        // Focus 第一格
        const newRow = document.getElementById('row-' + detail.id);
        const firstInput = newRow.querySelector('input[data-field="ProductCode"]');
        if (firstInput) firstInput.focus();

        updateDetailCount();
    } catch(e) {
        alert('新增失敗: ' + e.message);
    }
}

// ── 取消未儲存的新行：刪除 → 移除 DOM ──
async function cancelNewRow(id) {
    await fetch('/OrderChangeImport/DeleteDetail', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id })
    }).catch(() => {});
    const row = document.getElementById('row-' + id);
    if (row) row.remove();
    if (document.querySelectorAll('.detail-row').length === 0) location.reload();
    updateDetailCount();
}

function editRow(id) {
    const row = document.getElementById('row-' + id);
    row.querySelectorAll('.view-mode').forEach(td => td.classList.add('hidden'));
    row.querySelectorAll('.edit-mode').forEach(td => td.classList.remove('hidden'));
    row.classList.add('bg-blue-50/50');
}

function cancelRow(id) {
    const row = document.getElementById('row-' + id);
    row.querySelectorAll('.view-mode').forEach(td => td.classList.remove('hidden'));
    row.querySelectorAll('.edit-mode').forEach(td => td.classList.add('hidden'));
    row.classList.remove('bg-blue-50/50');
}

async function saveRow(id) {
    const row = document.getElementById('row-' + id);
    const data = { id: id, headerId: headerId };
    row.querySelectorAll('[data-field]').forEach(input => {
        let val = input.value;
        if (input.type === 'number') val = val ? parseFloat(val) : null;
        if (input.type === 'date') val = val || null;
        const field = input.dataset.field.charAt(0).toLowerCase() + input.dataset.field.slice(1);
        data[field] = val;
    });

    try {
        const resp = await fetch('/OrderChangeImport/UpdateDetail', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (!resp.ok) throw new Error('Failed');

        const cells = row.querySelectorAll('.view-mode');
        cells[0].textContent = data.productCode || '';
        cells[1].textContent = data.productName || '';
        cells[2].textContent = data.originalQuantity != null ? Number(data.originalQuantity).toLocaleString(undefined, {minimumFractionDigits:2}) : '';
        cells[3].textContent = data.newQuantity != null ? Number(data.newQuantity).toLocaleString(undefined, {minimumFractionDigits:2}) : '';
        cells[4].textContent = data.originalUnitPrice != null ? Number(data.originalUnitPrice).toLocaleString(undefined, {minimumFractionDigits:2}) : '';
        cells[5].textContent = data.newUnitPrice != null ? Number(data.newUnitPrice).toLocaleString(undefined, {minimumFractionDigits:2}) : '';
        cells[6].textContent = data.originalDeliveryDate || '';
        cells[7].textContent = data.newDeliveryDate || '';

        // Refresh highlight on changed values
        if (data.newQuantity != data.originalQuantity) cells[3].classList.add('text-orange-600'); else cells[3].classList.remove('text-orange-600');
        if (data.newUnitPrice != data.originalUnitPrice) cells[5].classList.add('text-orange-600'); else cells[5].classList.remove('text-orange-600');
        if (data.newDeliveryDate != data.originalDeliveryDate) cells[7].classList.add('text-orange-600'); else cells[7].classList.remove('text-orange-600');

        // 首次儲存後，取消按鈕改回標準 cancelRow
        const cancelBtn = row.querySelector('.edit-mode button[onclick*="cancelNewRow"]');
        if (cancelBtn) {
            cancelBtn.setAttribute('onclick', 'cancelRow(' + id + ')');
            cancelBtn.textContent = '取消';
        }

        cancelRow(id);
    } catch(e) {
        alert('儲存失敗: ' + e.message);
    }
}

async function deleteRow(id) {
    if (!confirm('確認刪除此明細？')) return;
    try {
        const resp = await fetch('/OrderChangeImport/DeleteDetail', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id })
        });
        if (!resp.ok) throw new Error('Failed');
        const row = document.getElementById('row-' + id);
        row.remove();
        const remaining = document.querySelectorAll('.detail-row').length;
        if (remaining === 0) location.reload();
        updateDetailCount();
    } catch(e) {
        alert('刪除失敗');
    }
}

function updateDetailCount() {
    const el = document.getElementById('detailCount');
    if (el) {
        const count = document.querySelectorAll('.detail-row').length;
        el.textContent = '(' + count + ' \u7B46)';
    }
}
</script>
