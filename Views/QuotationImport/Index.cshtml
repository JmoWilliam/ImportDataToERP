@model IEnumerable<ImportDataToERP.Models.QuotationImport>
@{
    ViewData["Title"] = "匯入報價單To ERP";
}

<div class="bg-white rounded-xl shadow p-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">📄 匯入報價單To ERP</h2>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm transition">+ 新增報價單</a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full border border-gray-200 rounded-lg">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">ID</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">報價單號</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">客戶編號</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">客戶名稱</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">品號</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">品名</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">數量</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">單價</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">幣別</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">狀態</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
                @if (!Model.Any())
                {
                    <tr><td colspan="11" class="px-4 py-10 text-center text-gray-400">尚無資料</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-4 py-3 text-sm text-gray-500">@item.Id</td>
                        <td class="px-4 py-3 text-sm font-medium">@item.QuotationNo</td>
                        <td class="px-4 py-3 text-sm">@item.CustomerCode</td>
                        <td class="px-4 py-3 text-sm">@item.CustomerName</td>
                        <td class="px-4 py-3 text-sm">@item.ProductCode</td>
                        <td class="px-4 py-3 text-sm">@item.ProductName</td>
                        <td class="px-4 py-3 text-sm text-right">@item.Quantity.ToString("N0")</td>
                        <td class="px-4 py-3 text-sm text-right">@item.UnitPrice.ToString("N2")</td>
                        <td class="px-4 py-3 text-sm text-center">@item.Currency</td>
                        <td class="px-4 py-3 text-center">
                            @if (item.ImportStatus == "已匯入")
                            {
                                <span class="bg-green-100 text-green-800 px-2.5 py-1 rounded-full text-xs font-medium">已匯入</span>
                            }
                            else
                            {
                                <span class="bg-yellow-100 text-yellow-800 px-2.5 py-1 rounded-full text-xs font-medium">待匯入</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-center text-sm space-x-2 whitespace-nowrap">
                            @if (item.ImportStatus != "已匯入")
                            {
                                <form asp-action="Import" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs transition">匯入</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('確認刪除？')">
                                <button type="submit" class="text-red-600 hover:text-red-800 text-xs font-medium">刪除</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
