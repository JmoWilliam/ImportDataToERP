@model ImportDataToERP.Models.UserCreateViewModel
@{
    ViewData["Title"] = "新增使用者";
}

<div class="max-w-xl mx-auto">
    <div class="bg-white rounded-xl shadow p-8">
        <h2 class="text-xl font-bold text-gray-800 mb-6">➕ 新增使用者</h2>

        <form asp-action="Create" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg border border-red-200"></div>

            <div>
                <label asp-for="Account" class="block text-sm font-medium text-gray-700 mb-1.5">帳號</label>
                <input asp-for="Account" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span asp-validation-for="Account" class="text-red-500 text-xs mt-1 inline-block"></span>
            </div>

            <div>
                <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1.5">姓名</label>
                <input asp-for="Name" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span asp-validation-for="Name" class="text-red-500 text-xs mt-1 inline-block"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 inline-block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1.5">密碼</label>
                <input asp-for="Password" type="password" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 inline-block"></span>
            </div>

            <div class="flex items-center gap-2.5 pt-1">
                <input asp-for="IsActive" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 h-4 w-4" checked="@Model.IsActive" />
                <label asp-for="IsActive" class="text-sm text-gray-700">啟用</label>
            </div>

            <div class="flex gap-3 pt-3">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition cursor-pointer">儲存</button>
                <a asp-action="Index" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2.5 rounded-lg text-sm transition">取消</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
