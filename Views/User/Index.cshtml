@model IEnumerable<ImportDataToERP.Models.User>
@{
    ViewData["Title"] = "使用者資料維護";
}

<div class="bg-white rounded-xl shadow p-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">👤 使用者資料維護</h2>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm transition">+ 新增使用者</a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full border border-gray-200 rounded-lg">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">帳號</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">姓名</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">狀態</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">建立時間</th>
                    <th class="px-5 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="px-5 py-10 text-center text-gray-400">尚無資料</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-5 py-3.5 text-sm text-gray-500">@item.Id</td>
                        <td class="px-5 py-3.5 text-sm font-medium">@item.Account</td>
                        <td class="px-5 py-3.5 text-sm">@item.Name</td>
                        <td class="px-5 py-3.5 text-sm text-gray-500">@item.Email</td>
                        <td class="px-5 py-3.5 text-sm">
                            @if (item.IsActive)
                            {
                                <span class="bg-green-100 text-green-800 px-2.5 py-1 rounded-full text-xs font-medium">啟用</span>
                            }
                            else
                            {
                                <span class="bg-red-100 text-red-800 px-2.5 py-1 rounded-full text-xs font-medium">停用</span>
                            }
                        </td>
                        <td class="px-5 py-3.5 text-sm text-gray-500 whitespace-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-5 py-3.5 text-sm text-center space-x-3 whitespace-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-800 font-medium">編輯</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('確認刪除？')">
                                <button type="submit" class="text-red-600 hover:text-red-800 font-medium">刪除</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
